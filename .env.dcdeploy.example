# DCDeploy / 无持久化卷容器平台环境变量配置示例
#
# 使用方式：
#   将本文件中的变量逐一填入 DCDeploy 控制台的「环境变量」配置面板。
#   不要将本文件直接上传到服务器，密钥类变量请勿提交到 Git 仓库。
#
# 与标准 .env.compose.example 的核心区别：
#   SESSION_SECRET 和 INBOX_TOKEN_SECRET 必须在此处预设，
#   容器启动后安装向导会检测到环境变量已注入，自动跳过写文件步骤。

# ============================================================
# 必填：基础服务地址
# ============================================================

# 应用对外访问地址（必须是 https，填你的真实域名）
PUBLIC_BASE_URL=https://mail.example.com

# 收信域名（MX 记录指向的主机名）
MAIL_HOSTNAME=mail.example.com

# MX 记录期望值（通常与 MAIL_HOSTNAME 相同）
EXPECTED_MX=mail.example.com

# ============================================================
# 必填：外部托管 PostgreSQL 连接串
# ============================================================
# 支持：Neon、Supabase、阿里云 RDS、腾讯云 TDSQL-PostgreSQL 等
# 格式：postgres://用户名:密码@主机:端口/数据库名?sslmode=require
#
# ── Neon（推荐，console.neon.tech）──────────────────────────
# 获取步骤：
#   1. 登录 https://console.neon.tech，进入你的项目
#   2. 左侧点击「Connection Details」
#   3. 「Connection string」选项卡下复制完整连接串
#      格式示例：
#      postgres://用户名:密码@ep-xxx-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   4. 粘贴到下方 HLOOLMAIL_DATABASE_URL 的值
#
# 注意（Neon 免费版）：
#   - 最大并发连接数为 25（与 DB_MAX_OPEN_CONNS 默认值一致，无需修改）
#   - 数据库在 5 分钟不活跃后会自动暂停（冷启动约 1-2 秒），生产建议升级到付费计划
#   - 推荐使用 Neon 的 Pooler 连接串（Connection string 界面切换到「Pooled connection」）
#     Pooler 连接串端口为 5432，能大幅减少连接数消耗
#
# Neon 示例（直连，端口 5432）：
#   postgres://用户名:密码@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Neon 示例（Pooler，推荐生产使用）：
#   postgres://用户名:密码@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
#
# ── Supabase ─────────────────────────────────────────────────
# 获取步骤：
#   1. 登录 https://supabase.com/dashboard，进入你的项目
#   2. 左侧点击「Settings → Database」
#   3. 复制「Connection string → URI」
# Supabase 示例（Transaction Pooler，推荐）：
#   postgres://postgres.xxxx:密码@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# ── 其他 PostgreSQL ──────────────────────────────────────────
#   postgres://用户名:密码@主机:端口/数据库名?sslmode=require
HLOOLMAIL_DATABASE_URL=postgres://用户名:密码@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ============================================================
# 必填：密钥（必须预设，容器重启后保持不变）
# ============================================================
# 生成方式（在本地终端执行）：
#   SESSION_SECRET:    openssl rand -base64 32
#   INBOX_TOKEN_SECRET: openssl rand -base64 32
# 两个值必须不同，长度至少 16 位。
# 一旦设定后不要修改，否则所有登录态和收件箱 Token 失效。

SESSION_SECRET=替换为随机字符串-至少32位
INBOX_TOKEN_SECRET=替换为另一个随机字符串-至少32位

# ============================================================
# 必填：管理员初始化 Token（安装向导使用，安装后可留空）
# ============================================================
ADMIN_TOKEN=

# ============================================================
# 端口映射（DCDeploy 通常自动分配，按需修改）
# ============================================================
HTTP_PORT=3000
# SMTP 端口：生产环境建议改为 25（需云平台开放入站 TCP 25）
SMTP_PORT=2525

# ============================================================
# 可选：数据库连接池
# ============================================================
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# ============================================================
# 可选：功能配置
# ============================================================
PUBLIC_INDEXING=landing
MX_STRICT=false
DEV_MODE=false
ALLOW_LEGACY_ADMIN_TOKEN=false
MESSAGE_RETENTION_HOURS=24
AUDIT_LOG_RETENTION_DAYS=180
AUDIT_ACTIVITY_RETENTION_DAYS=30
METRICS_ENABLED=false
WEBHOOKS_ENABLED=true
DISABLE_PENDING_DOMAIN_DATA_PROTECTION=false
MAX_MESSAGE_BYTES=10485760
MAX_ATTACHMENT_BYTES=10485760
API_KEY_DEFAULT_DAILY_LIMIT=200000
ALLOW_API_KEY_QUERY_PARAM=false

# ============================================================
# 可选：GitHub OAuth 登录
# ============================================================
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=
GITHUB_OAUTH_ENABLED=false

# ============================================================
# 可选：LinuxDo OAuth 登录
# ============================================================
LINUXDO_OAUTH_CLIENT_ID=
LINUXDO_OAUTH_CLIENT_SECRET=
LINUXDO_OAUTH_REDIRECT_URL=
LINUXDO_OAUTH_ENABLED=false

# ============================================================
# 可选：镜像源加速（中国大陆环境构建时使用）
# ============================================================
GOPROXY=https://proxy.golang.org|https://goproxy.cn|direct
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
